CompileFlags:
  # Path to compile_commands.json generated by CMake
  CompilationDatabase: "build"
  Add:
    - -std=c++17
    - -Wall
    - -Wextra
    - -Wpedantic

Diagnostics:
  # Enable integration with .clang-tidy file
  ClangTidy:
    Add:
      - readability-*
      - modernize-*
      - performance-*
      - bugprone-*
    Remove:
      - readability-magic-numbers
  UnusedIncludes: Strict

InlayHints:
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes